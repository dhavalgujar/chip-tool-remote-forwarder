# SPDX-License-Identifier: Apache-2.0

# chip-tool-gw: upstream chip-tool's commands (chip-tool-utils, unmodified)
# plus the client for the Matter gateway; mgw-host: the gateway relay
# on a host (tests). The symlinks (build_overrides, third_party/connectedhomeip,
# core) are made by build.sh.

import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

config("gateway_config") {
  include_dirs = [
    "gateway",
    "core",
  ]
}

executable("chip-tool-gw") {
  sources = [
    "core/mgw_keys.cpp",
    "core/mgw_proto.cpp",
    "core/mgw_tls_openssl.cpp",
    "gateway/GatewayClient.cpp",
    "gateway/GatewayCommands.cpp",
    "gateway/GatewayDial.cpp",
    "gateway/GatewaySecretFile.cpp",
    "gateway/GatewaySessions.cpp",
    "gateway/GatewaySigner.cpp",
    "gateway/GatewayStream.cpp",
    "main.cpp",
  ]
  configs += [ ":gateway_config" ]
  deps = [
    "${chip_root}/examples/chip-tool:chip-tool-utils",
    "${chip_root}/src/platform/logging:stdio",
  ]
  output_dir = root_out_dir
}

executable("mgw-host") {
  sources = [
    "core/mgw_keys.cpp",
    "core/mgw_listener.cpp",
    "core/mgw_proto.cpp",
    "core/mgw_relay.cpp",
    "core/mgw_server.cpp",
    "core/mgw_tls_openssl.cpp",
    "gateway/GatewaySecretFile.cpp",
    "gateway/GatewayServeCommand.cpp",
    "mgw_host_main.cpp",
  ]
  configs += [ ":gateway_config" ]
  deps = [
    "${chip_root}/examples/chip-tool:chip-tool-utils",
    "${chip_root}/src/platform/logging:stdio",
  ]
  output_dir = root_out_dir
}

group("default") {
  deps = [
    ":chip-tool-gw",
    ":mgw-host",
  ]
}
